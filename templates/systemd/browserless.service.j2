[Unit]
Description=Browserless ({{ browserless_identifier }})
{% for service in browserless_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in browserless_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ sysd_docker_unit_home_path }}"
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ browserless_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ browserless_identifier }} 2>/dev/null || true'

{#
  Setting --read-only prevents the container from working properly.
#}
ExecStartPre={{ sysd_docker_host_command }} create \
      --rm \
      --name={{ browserless_identifier }} \
      --log-driver=none \
      --user={{ browserless_uid }}:{{ browserless_gid }} \
      --cap-drop=ALL \
      --network={{ browserless_container_network }} \
      {% if browserless_container_http_host_bind_port %}
      -p {{ browserless_container_http_host_bind_port }}:{{ browserless_container_http_port }} \
      {% endif %}
      --env-file={{ browserless_base_path }}/env \
      --label-file={{ browserless_base_path }}/labels \
      {% for volume in browserless_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options else '' }} \
      {% endfor %}
      --tmpfs=/tmp:rw,noexec,nosuid,size=100m \
      {% for arg in browserless_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ browserless_container_image }}

{% for network in browserless_container_additional_networks %}
ExecStartPre={{ sysd_docker_host_command }} network connect {{ network }} {{ browserless_identifier }}
{% endfor %}

ExecStart={{ sysd_docker_host_command }} start --attach {{ browserless_identifier }}

ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ browserless_identifier }} 2>/dev/null || true'
ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ browserless_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ browserless_identifier }}

[Install]
WantedBy=multi-user.target
